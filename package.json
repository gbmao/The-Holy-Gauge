{
  "name": "controlador-da-moto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-sqlite-wasm.mjs && vite build",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:install": "npm run android:build && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "6.0.2",
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.1",
    "jeep-sqlite": "2.7.2",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "vite": "6.4.3"
  }
}
